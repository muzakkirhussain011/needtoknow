schema needtoknow {
    document needtoknow {
        field needtoknow_id type string {
            indexing: attribute | summary
        }
        field text type string {
            indexing: index | summary
            index: enable-bm25
        }
        field needtoknow_metadata type string {
            indexing: summary
        }
        field needtoknow_terms type array<string> {
            indexing: attribute
            attribute: fast-search
        }
        field embedding type tensor<float>(x[16]) {
            indexing: attribute | index
            attribute {
                distance-metric: angular
            }
        }
    }
    rank-profile needtoknow {
        inputs {
            query(q) tensor<float>(x[16])
        }
        first-phase {
            expression: cos(distance(field, embedding))
        }
    }
    rank-profile needtoknow_bm25 {
        first-phase {
            expression: bm25(text)
        }
    }
}
