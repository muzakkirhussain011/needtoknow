    given-names: Syed Muzakkir
version: 1.1.1
date-released: 2026-10-16
license: MIT
repository-code: "https://github.com/muzakkirhussain011/needtoknow"
url: "https://muzakkirhussain011.github.io/needtoknow/"
keywords:
  - retrieval-augmented generation
  - access control
  - authorization
  - vector search
  - information retrieval
